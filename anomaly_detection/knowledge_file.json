{
  "call_drop": {
    "label": "Call Drop",
    "causes": [
      "Poor signal level (low RSRP)",
      "Low SINR / high interference",
      "Failed handover (low HO success rate)",
      "Overshooting cell",
      "Missing or poor neighbor relations",
      "Incorrect antenna tilt/azimuth",
      "VoLTE issue (SRVCC failure)"
    ],
    "solutions": [
      "Optimize mechanical/electrical antenna tilt",
      "Adjust cell transmit power",
      "Optimize neighbor list",
      "Optimize handover parameters",
      "Analyze coverage holes and add a site/small cell if needed"
    ]
  },
  "voice_quality": {
    "label": "Poor Voice Quality (Low MOS)",
    "causes": [
      "Uplink/downlink interference (poor RSRP/SINR conditions)",
      "High BLER",
      "Suboptimal codec configuration",
      "PRB congestion",
      "Poor indoor coverage"
    ],
    "solutions": [
      "Enable adaptive AMR",
      "Optimize uplink transmit power",
      "Tune scheduler to prioritize VoLTE traffic",
      "Add 800/900 MHz layer for indoor coverage",
      "Deploy IBS/small cells"
    ]
  },
  "low_throughput": {
    "label": "Low Throughput",
    "causes": [
      "Low SINR",
      "PRB congestion",
      "Poor CQI",
      "Low MIMO rank",
      "Insufficient bandwidth or unsuitable carrier"
    ],
    "solutions": [
      "Optimize antenna tilt",
      "Add carrier / activate carrier aggregation",
      "Enable 4x4 MIMO",
      "Tune CQI-related parameters",
      "Increase bandwidth (e.g., 10 to 20 MHz)"
    ]
  },
  "high_latency": {
    "label": "High Latency",
    "causes": [
      "Transport congestion (high delay)",
      "Suboptimal IP routing",
      "Bufferbloat",
      "UPF/SGW core network issue",
      "RLC retransmissions"
    ],
    "solutions": [
      "Optimize buffer settings",
      "Upgrade transport network capacity",
      "Verify MTU configuration",
      "Optimize scheduling policy",
      "Enable local breakout where applicable"
    ]
  },
  "session_data_drop": {
    "label": "Session Data Drop",
    "causes": [
      "ERAB drop",
      "Inter-frequency handover failure",
      "Coverage hole"
    ],
    "solutions": [
      "Optimize handover thresholds and timer behavior",
      "Adjust T310 timer",
      "Deploy/add 800 MHz coverage cells",
      "Analyze drive test logs (L3 events)"
    ]
  },
  "handover_failure": {
    "label": "Handover Failure",
    "causes": [
      "Poor neighbor relation definition",
      "Overshooting cell",
      "PCI confusion"
    ],
    "solutions": [
      "Clean and normalize PCI plan",
      "Optimize A3 offset",
      "Adjust TTT (Time to Trigger)"
    ]
  },
  "capacity_issue": {
    "label": "Capacity Issues",
    "causes": [
      "PRB utilization above 85%",
      "CSSR degradation during peak hours",
      "Throughput drop during busy hour"
    ],
    "symptoms": [
      "PRB > 85%",
      "CSSR drops in busy hours",
      "Throughput decreases at peak time"
    ],
    "solutions": [
      "Add carrier capacity",
      "Enable carrier aggregation",
      "Sectorize (e.g., 3 to 6 sectors)",
      "Deploy Massive MIMO",
      "Apply load balancing"
    ]
  },
  "interference": {
    "label": "Interference",
    "causes": [
      "Adjacent channel interference",
      "External interference source",
      "PCI conflicts or confusion",
      "Poor frequency reuse plan"
    ],
    "solutions": [
      "Optimize PCI planning",
      "Apply ICIC/eICIC where relevant",
      "Retune RF parameters",
      "Clean external interferers and validate spectrum usage"
    ]
  }
}